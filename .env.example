// Environment Configuration for Translation APIs
// Copy this file to .env or set these as environment variables

// Google Cloud Translation API Configuration
// Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here

// Optional: MyMemory API email (for better rate limits)
// Sign up at: https://mymemory.translated.net/
MYMEMORY_EMAIL=your-email@example.com

// For web applications, you can also set these in your build environment
// or directly in the translationApiConfig.js file

export const API_KEYS = {
    googleTranslate: process.env.GOOGLE_TRANSLATE_API_KEY || '',
    myMemoryEmail: process.env.MYMEMORY_EMAIL || ''
};
